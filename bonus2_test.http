[
  { "memberIdentifier": "C3-M1", "attendanceStatus": "ATTENDED" },
  { "memberIdentifier": "C3-M2", "attendanceStatus": "MISSING"  },
  { "memberIdentifier": "C3-M3", "attendanceStatus": "ATTENDED" },
