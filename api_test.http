### Variables globales
@baseUrl = http://localhost:8080
@validCollectivityId = col-1
@validCollectivityId2 = col-2
@validCollectivityId3 = col-3
@invalidCollectivityId = 99999999-9999-9999-9999-999999999999

@validMemberId = C1-M1
@invalidMemberId = 99999999-9999-9999-9999-999999999999

@validFeeId = cot-1
@validAccountId = C1-A-CASH


### POST /collectivities — CAS NOMINAL (SUCCÈS 201)
POST {{baseUrl}}/collectivities
Content-Type: application/json

[
  {
    "location": "Antananarivo",
    "specialty": "Maraîchage",
    "federationApproval": true,
    "members": [
      "C1-M1", "C1-M2", "C1-M3", "C1-M4", "C1-M5",
      "C1-M6", "C1-M7", "C1-M8", "C3-M1", "C3-M2"
    ],
    "structure": {
      "president": "C1-M1",
      "vicePresident": "C1-M2",
      "treasurer": "C1-M4",
      "secretary": "C1-M3"
    }
  }
]

